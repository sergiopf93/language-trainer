  "theories": [
    {
      "id": "it-a1-theory-c33-01",
      "version": "theory-c33-01-1",
      "conceptId": "it-a1-c33-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Arrivato, arrivata, arrivati, arrivate",
      "goal": "Concordar el participio con género y número del sujeto cuando el auxiliar es essere.",
      "introduction": "Con essere el participio concuerda con quien realiza la acción. El referente puede estar escrito o quedar claro por el contexto.",
      "rules": [
        "Masculino singular -o: Marco è arrivato; femenino singular -a: Anna è arrivata.",
        "Masculino plural o grupo mixto -i: Marco e Anna sono arrivati; grupo femenino -e: Anna e Eva sono arrivate.",
        "La persona se expresa en el auxiliar; género y número, en el participio: siamo arrivate si hablan varias mujeres.",
        "En el alcance con avere sin clíticos antepuestos, no se hace esta concordancia con el sujeto: Anna ha lavorato."
      ],
      "forms": [
        [
          "Marco",
          "è arrivato"
        ],
        [
          "Anna",
          "è arrivata"
        ],
        [
          "Marco e Luca / Marco e Anna",
          "sono arrivati"
        ],
        [
          "Anna e Eva",
          "sono arrivate"
        ]
      ],
      "examples": [
        [
          "Anna è partita ieri.",
          "Anna se fue ayer."
        ],
        [
          "Siamo arrivate in hotel.",
          "Hemos llegado al hotel (hablan mujeres)."
        ],
        [
          "Luca e Anna sono usciti.",
          "Luca y Anna salieron."
        ]
      ],
      "frequentErrors": [
        "No escribas Anna è arrivato ni le ragazze sono arrivati.",
        "No extiendas la regla a Anna ha lavorata: con avere en este alcance es lavorato."
      ],
      "usageNotes": [
        "Los sujetos y su género están fijados en las consignas. Las reglas de concordancia con clíticos quedan fuera."
      ],
      "exceptions": [],
      "contrasts": [],
