  "theories": [
    {
      "id": "it-a1-theory-c24-01",
      "version": "theory-c24-01-1",
      "conceptId": "it-a1-c24-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Questo, questa, questi, queste",
      "goal": "Señalar referentes cercanos con questo y sus formas concordadas.",
      "introduction": "Questo identifica una persona o cosa próxima a quien habla o que se está presentando. Concuerda con el referente en género y número.",
      "rules": [
        "Formas: questo libro, questa penna, questi libri, queste penne. No se antepone artículo determinado.",
        "Puede acompañar al nombre o sustituirlo si se entiende: questa penna / questa.",
        "Ante vocal singular puede aparecer quest’: quest’amico. La forma plena questo amico también es posible; el plural conserva questi/queste."
      ],
      "forms": [
        [
          "questo / questa",
          "este / esta"
        ],
        [
          "questi / queste",
          "estos / estas"
        ],
        [
          "quest’amico / questo amico",
          "este amigo"
        ]
      ],
      "examples": [
        [
          "Questo libro è qui.",
          "Este libro está aquí."
        ],
        [
          "Vorrei questa penna.",
          "Quisiera este bolígrafo."
        ]
      ],
      "frequentErrors": [
        "No uses il questo libro.",
        "Questi no sirve para un grupo femenino plural: queste penne."
      ],
      "usageNotes": [
        "La cercanía se indica en el contexto escrito; no se requiere interpretar una imagen ausente."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-questo",
        "it-libro",
        "it-penna",
        "it-amico",
        "it-casa",
        "it-vorrei",
        "it-qui"
      ],
      "status": "candidate",
      "provenance": "Candidate de R2: Research 02 C18–C25 y A1_COVERAGE_MATRIX. Ejemplos originales; revisión editorial independiente pendiente. Research 02 C24; A1_COVERAGE_MATRIX C24. https://www.treccani.it/enciclopedia/aggettivi-dimostrativi_%28La-grammatica-italiana%29/"
    },
    {
      "id": "it-a1-theory-c24-02",
      "version": "theory-c24-02-1",
      "conceptId": "it-a1-c24-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Quello e il contrasto con questo",
      "goal": "Señalar referentes lejanos con formas frecuentes de quello y contrastarlos con questo.",
      "introduction": "Quello puede señalar algo alejado de quien habla o previamente mencionado. Delante de un nombre masculino adopta formas que recuerdan a il/lo/l’ y i/gli.",
      "rules": [
        "Delante del nombre: quel libro, quello zaino, quell’amico; quei libri, quegli zaini, quegli amici.",
        "Femenino: quella penna, quell’amica; quelle penne.",
        "Si sustituye al nombre, usa quello/quella/quelli/quelle: vorrei quello. No uses quel solo.",
        "Questo y quello permiten contrastar cerca/lejos; no se añade un artículo delante."
      ],
      "forms": [
        [
          "quel libro / quei libri",
          "ese libro / esos libros"
        ],
        [
          "quello zaino / quegli zaini",
          "esa mochila / esas mochilas"
        ],
        [
          "quell’amico / quegli amici",
          "ese amigo / esos amigos"
        ],
        [
          "quella penna / quelle penne",
          "ese bolígrafo / esos bolígrafos"
        ],
        [
          "quello / quelli",
          "ese / esos, sin nombre"
        ]
      ],
      "examples": [
        [
          "Vorrei quel libro.",
          "Quisiera ese libro."
        ],
        [
          "Questa penna è qui; quella penna è là.",
          "Este bolígrafo está aquí; ese bolígrafo está allí."
        ]
      ],
      "frequentErrors": [
        "No uses quello libro delante de libro: quel libro.",
        "Sin nombre no uses quel: vorrei quello."
      ],
      "usageNotes": [
        "Se limita a las formas frecuentes documentadas, sin otros demostrativos ni usos discursivos avanzados."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-quello",
        "it-questo",
        "it-libro",
        "it-zaino",
        "it-amico",
        "it-penna",
        "it-vorrei",
        "it-qui",
        "it-la-luogo"
      ],
      "status": "candidate",
