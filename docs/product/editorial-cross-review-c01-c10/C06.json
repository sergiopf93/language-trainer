  "theories": [
    {
      "id": "it-a1-theory-c06-01",
      "version": "theory-c06-01-1-editorial-1",
      "conceptId": "it-a1-c06-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Non ho fame",
      "goal": "Negar declaraciones sencillas con non delante de essere o avere.",
      "introduction": "Non niega lo que dice el verbo. Reutiliza las formas de essere y avere que ya conoces: no cambia la persona ni la forma verbal.",
      "rules": [
        "Coloca non inmediatamente antes del verbo en estas frases: non sono, non hai, non è, non abbiamo.",
        "Si expresas el sujeto, va antes de non en el orden neutro: Anna non è qui. El sujeto puede omitirse cuando se entiende.",
        "«No» sirve como respuesta independiente negativa; «non» acompaña al verbo: No, non ho fame."
      ],
      "forms": [
        [
          "non sono / non sei / non è",
          "no soy-estoy / no eres-estás / no es-está"
        ],
        [
          "non ho / non hai / non ha",
          "no tengo / no tienes / no tiene"
        ]
      ],
      "examples": [
        [
          "Non sono a casa.",
          "No estoy en casa."
        ],
        [
          "Anna non ha sonno.",
          "Anna no tiene sueño."
        ],
        [
          "No, non ho una chiave.",
          "No, no tengo una llave."
        ]
      ],
      "frequentErrors": [
        "«Sono non a casa» no es el orden neutro enseñado; escribe non sono a casa.",
        "«No ho fame» confunde la respuesta no con la negación non."
      ],
      "usageNotes": [
        "Se practica una negación simple; nadie, nada y negaciones complejas quedan fuera de este concepto."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-non",
        "it-no",
        "it-essere",
        "it-avere",
        "it-casa",
        "it-qui",
        "it-sonno",
        "it-fame",
        "it-chiave"
      ]
    },
    {
      "id": "it-a1-theory-c06-02",
      "version": "theory-c06-02-1",
      "conceptId": "it-a1-c06-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Hai una chiave?",
      "goal": "Comprender, formular y responder preguntas cerradas escritas con essere y avere.",
      "introduction": "Una pregunta cerrada permite confirmar o negar un dato. En italiano escrito puede mantener el orden de la afirmación y terminar con ?.",
      "rules": [
        "Hai una chiave. afirma; Hai una chiave? pregunta. No se añade un verbo auxiliar para preguntar.",
        "El signo de interrogación se escribe al final; no se usa ¿ al principio en italiano.",
        "Al responder a sei/hai sobre ti, usa sono/ho. Sì confirma; no niega y puede continuar con non + verbo."
      ],
      "forms": [
        [
          "Sei a casa?",
          "¿Estás en casa?"
        ],
        [
          "Sì, sono a casa. / No, non sono a casa.",
          "Sí, estoy en casa. / No, no estoy en casa."
        ]
      ],
      "examples": [
        [
          "Hai una penna? Sì, ho una penna.",
          "¿Tienes un bolígrafo? Sí, tengo un bolígrafo."
        ],
        [
          "Anna è qui? No, Anna non è qui.",
          "¿Anna está aquí? No, Anna no está aquí."
        ]
      ],
      "frequentErrors": [
        "No copies hai al contestar sobre ti: la respuesta usa ho.",
        "Sì lleva acento cuando significa sí; si sin acento no es la afirmación."
      ],
      "usageNotes": [
        "La entonación oral es importante, pero aquí solo se evalúa la pregunta escrita."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-avere",
        "it-essere",
        "it-si",
        "it-no",
        "it-non",
        "it-chiave",
        "it-penna",
        "it-casa",
        "it-qui"
      ]
    },
    {
      "id": "it-a1-theory-c06-03",
      "version": "theory-c06-03-1",
      "conceptId": "it-a1-c06-03",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Chi, dove, come?",
      "goal": "Elegir y recuperar interrogativos para persona, lugar, manera, cosa, tiempo, motivo y edad.",
      "introduction": "El interrogativo indica qué información falta. Aprende cada palabra junto con la respuesta que solicita, no como una lista aislada.",
      "rules": [
        "Chi pregunta por una persona; dove por un lugar; come por una manera o un estado: Come stai? es una fórmula.",
        "Che cosa (también cosa o che) pregunta qué; quando pregunta cuándo; perché pregunta por qué. Perché también introduce una causa en respuestas, uso que se ampliará en C29.",
        "Quanto cambia en preguntas como Quanti anni hai?; aquí la edad se recupera como fórmula ya aprendida. Di dove sei? pregunta origen, Dove sei? ubicación."
      ],
      "forms": [
        [
          "chi / dove / come",
          "quién / dónde / cómo"
        ],
        [
          "che cosa / quando / perché",
          "qué / cuándo / por qué"
        ],
        [
          "quanti anni hai?",
          "¿cuántos años tienes?"
        ],
        [
          "come stai? / sto bene",
          "¿cómo estás? / estoy bien"
        ]
      ],
      "examples": [
        [
          "Chi è? È Anna.",
          "¿Quién es? Es Anna."
        ],
        [
          "Dove sei? Sono a casa.",
          "¿Dónde estás? Estoy en casa."
        ],
        [
          "Quando sei a casa? Oggi.",
          "¿Cuándo estás en casa? Hoy."
        ],
        [
          "Che cosa hai? Ho una chiave.",
          "¿Qué tienes? Tengo una llave."
        ]
      ],
      "frequentErrors": [
        "Chi solicita una persona, no un lugar. Dove sei? y Di dove sei? no piden el mismo dato."
      ],
      "usageNotes": [
        "Oggi significa hoy. Come stai? se aprende como fórmula; aquí no se introduce el paradigma de stare."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-chi",
        "it-dove",
        "it-come",
        "it-che-cosa",
        "it-quando",
        "it-perche",
        "it-quanti-anni",
