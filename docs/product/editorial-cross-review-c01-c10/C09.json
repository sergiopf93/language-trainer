  "theories": [
    {
      "id": "it-a1-theory-c09-01",
      "version": "theory-c09-01-1-editorial-1",
      "conceptId": "it-a1-c09-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Il, lo, la, l’",
      "goal": "Elegir el artículo determinado singular según género e inicio del nombre en el repertorio A1 enseñado.",
      "introduction": "Primero recupera el género del nombre; después mira cómo empieza. El artículo acompaña al nombre y su forma depende de ambos datos.",
      "rules": [
        "Masculino: il ante consonante habitual (il letto); lo ante s + consonante y z (lo studente, lo zaino), también gn, ps y otros grupos (lo gnocco, lo psicologo). Ante vocal se usa l’: l’amico.",
        "Femenino: la ante consonante, incluso s + consonante o z: la penna, la studentessa. Ante vocal se usa l’: l’amica.",
        "L’ se escribe unido al nombre y sirve para ambos géneros: no permite deducir por sí solo si un nombre es masculino o femenino."
      ],
      "forms": [
        [
          "il letto / lo studente / lo zaino",
          "la cama / el estudiante / la mochila"
        ],
        [
          "l’amico / l’amica",
          "el amigo / la amiga"
        ],
        [
          "la penna / la studentessa",
          "el bolígrafo / la estudiante"
        ]
      ],
      "examples": [
        [
          "Il letto è qui.",
          "La cama está aquí."
        ],
        [
          "Lo zaino è qui.",
          "La mochila está aquí."
        ],
        [
          "L’amica è a casa.",
          "La amiga está en casa."
        ]
      ],
      "frequentErrors": [
        "No uses lo con cualquier palabra que empiece por s: il sonno tiene s + vocal.",
        "La studentessa es femenino: la regla de lo afecta a nombres masculinos."
      ],
      "usageNotes": [
        "Los grupos gn/ps se enseñan con gnocco y psicologo; x, pn e i/j con valor de semiconsonante requieren repertorio específico; no todas las semiconsonantes seleccionan lo. No se generan combinaciones nuevas automáticamente."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-letto",
        "it-studente",
        "it-zaino",
        "it-amico",
        "it-penna",
        "it-studentessa",
        "it-sonno",
        "it-gnocco",
        "it-psicologo",
        "it-articolo-determinativo"
      ]
    },
    {
      "id": "it-a1-theory-c09-02",
      "version": "theory-c09-02-1",
      "conceptId": "it-a1-c09-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "I, gli, le",
      "goal": "Elegir i/gli/le con plurales del repertorio y relacionarlos con su singular.",
      "introduction": "El plural conserva el género del nombre, pero cambia la serie del artículo: il → i, lo/l’ masculino → gli, la/l’ femenino → le.",
      "rules": [
        "I acompaña masculinos que en singular llevan il: il letto → i letti. Gli acompaña masculinos ante vocal y los grupos de lo: gli amici, gli studenti, gli zaini, gli gnocchi, gli psicologi.",
        "Le se usa con todos los femeninos plurales del repertorio: le penne, le amiche, le chiavi; no depende de si empiezan por vocal.",
        "En la escritura corriente aquí enseñada, gli amici y le amiche mantienen su vocal y un espacio; no se usa l’ como plural."
      ],
      "forms": [
        [
          "il letto → i letti",
          "la cama → las camas"
        ],
        [
          "lo studente → gli studenti",
          "el estudiante → los estudiantes"
        ],
        [
          "l’amico → gli amici / l’amica → le amiche",
          "el amigo → los amigos / la amiga → las amigas"
        ]
      ],
      "examples": [
        [
          "I biglietti sono qui.",
          "Los billetes están aquí."
        ],
        [
          "Le chiavi sono qui.",
          "Las llaves están aquí."
        ],
        [
          "Gli zaini sono qui.",
          "Las mochilas están aquí."
        ]
      ],
      "frequentErrors": [
        "«I studenti» ignora s + consonante.",
        "L’ no revela el género: l’amico da gli amici; l’amica da le amiche."
      ],
      "usageNotes": [
        "Se proporcionan amici/amiche, gnocchi y psicologi para centrar la tarea en el artículo, sin evaluar alternancias gráficas nuevas."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-letto",
        "it-biglietto",
        "it-studente",
        "it-zaino",
        "it-amico",
        "it-chiave",
        "it-penna",
        "it-gnocco",
        "it-psicologo",
        "it-articolo-determinativo"
      ]
    },
    {
      "id": "it-a1-theory-c09-03",
      "version": "theory-c09-03-1",
      "conceptId": "it-a1-c09-03",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "La chiave: sappiamo quale",
      "goal": "Usar el determinado para un referente ya mencionado o identificable en la situación.",
      "introduction": "El artículo no solo tiene una forma: ayuda a saber de qué objeto hablamos. Usa el determinado cuando el interlocutor puede identificar el referente.",
      "rules": [
        "Tras introducir una cosa, el determinado puede retomarla: Ho una chiave. La chiave è qui.",
        "También puede identificar algo compartido en la situación sin una mención previa: en una habitación con una sola cama, il letto.",
        "El indeterminado introduce un referente sin pedir al interlocutor que sepa cuál. La elección se decide por el contexto, no solo por el nombre."
      ],
      "forms": [
        [
          "una chiave → la chiave",
          "una llave nueva en el discurso → esa llave identificable"
        ],
        [
          "un biglietto → il biglietto",
          "un billete introducido → el billete ya conocido"
        ]
      ],
      "examples": [
        [
          "Ho una penna. La penna è qui.",
          "Tengo un bolígrafo. El bolígrafo está aquí."
        ],
        [
          "Il letto è qui.",
          "La cama está aquí (la única de la habitación compartida)."
        ]
      ],
      "frequentErrors": [
        "No cambies automáticamente a un/una cuando retomas exactamente el mismo referente.",
        "No toda primera mención exige un: una situación compartida puede identificar el objeto."
      ],
      "usageNotes": [
        "No se trabajan aquí todos los usos genéricos del determinado. C10-02 practica la introducción de referentes."
      ],
      "exceptions": [],
      "contrasts": [
        {
          "conceptId": "it-a1-c10-02",
          "explanation": "El determinado retoma o identifica; el indeterminado introduce un referente no identificado para el interlocutor."
        }
      ],
      "vocabularyIds": [
        "it-chiave",
        "it-penna",
        "it-biglietto",
        "it-letto",
        "it-casa",
        "it-articolo-determinativo",
        "it-articolo-indeterminativo"
      ]
    }
  ],
