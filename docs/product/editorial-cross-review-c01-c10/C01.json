  "theories": [
    {
      "id": "it-a1-theory-c01-01",
      "version": "theory-c01-01-1",
      "conceptId": "it-a1-c01-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Scrivere: chi, gi, sc, gn, gli",
      "goal": "Reconocer y escribir c/ch, g/gh, sc, gn y gli en palabras enseñadas, sin evaluar pronunciación.",
      "introduction": "Algunas letras italianas trabajan juntas. Aprende la palabra con su significado y fíjate en el grupo completo: no traslades automáticamente la ortografía española.",
      "rules": [
        "Ante e/i, c y g tienen un sonido distinto del que tienen ante a/o/u. La h de che/chi y ghe/ghi mantiene el sonido de c de casa y de g de gatto.",
        "En las palabras enseñadas, sc ante e/i aparece en pesce y scimmia; gn en bagno recuerda a la ñ española. Aprende gli dentro de famiglia y biglietto; no lo sustituyas por li.",
        "La h de estos grupos no se pronuncia por separado. Aquí comprobarás escritura y reconocimiento; una respuesta escrita no demuestra pronunciación."
      ],
      "forms": [
        [
          "casa / ciao",
          "casa / hola; c ante a / grupo ci ante a"
        ],
        [
          "chiave / amiche",
          "llave / amigas; chi / che"
        ],
        [
          "gatto / gelato",
          "gato / helado; g ante a / g ante e"
        ],
        [
          "spaghetti / ghiaccio",
          "espaguetis / hielo; ghe / ghi"
        ],
        [
          "pesce / scimmia",
          "pescado / mono; sce / sci"
        ],
        [
          "bagno",
          "baño; gn"
        ],
        [
          "famiglia / biglietto",
          "familia / billete; gli"
        ]
      ],
      "examples": [
        [
          "La chiave.",
          "La llave."
        ],
        [
          "Un gelato.",
          "Un helado."
        ],
        [
          "Il bagno.",
          "El baño."
        ],
        [
          "La famiglia.",
          "La familia."
        ]
      ],
      "frequentErrors": [
        "«Spagetti» pierde la h de spaghetti; «banio» no reproduce la grafía de bagno."
      ],
      "usageNotes": [
        "En una estación puedes necesitar escribir biglietto; en un hotel, chiave o bagno. El significado ayuda a reconocer la palabra, pero no dicta su ortografía.",
        "No generalices la lectura de gli a cualquier palabra con gl. Practica primero el repertorio mostrado."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-chiave",
        "it-amico",
        "it-gelato",
        "it-spaghetti",
        "it-ghiaccio",
        "it-pesce",
        "it-scimmia",
        "it-bagno",
        "it-famiglia",
        "it-biglietto",
        "it-casa",
        "it-gatto",
        "it-ciao"
      ]
    },
    {
      "id": "it-a1-theory-c01-02",
      "version": "theory-c01-02-1",
      "conceptId": "it-a1-c01-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "L’accento: e oppure è?",
      "goal": "Escribir los acentos del repertorio inicial y distinguir e/è en contexto.",
      "introduction": "En italiano el acento escrito puede distinguir palabras. No se aplican las reglas de tilde del español: aprende caffè, città y perché con su grafía.",
      "rules": [
        "E une elementos; è es una forma de essere. También se distinguen sì (afirmación) y si (otra palabra, cuyo uso se estudiará después).",
        "En las palabras de este repertorio con varias sílabas y acento en la última se escribe el acento: città, caffè, perché. Perché lleva é; caffè lleva è."
      ],
      "forms": [
        [
          "e",
          "y"
        ],
        [
          "è",
          "es / está"
        ],
        [
          "sì",
          "sí"
        ],
        [
          "città",
          "ciudad"
        ],
        [
          "caffè",
          "café"
        ],
        [
          "perché",
          "por qué / porque"
        ]
      ],
      "examples": [
        [
          "Anna e Luca.",
          "Anna y Luca."
        ],
        [
          "Anna è a Roma.",
          "Anna está en Roma."
        ],
        [
          "Sì, un caffè.",
          "Sí, un café."
        ]
      ],
      "frequentErrors": [
        "«Anna e a Roma» no equivale a «Anna è a Roma». El acento forma parte de la respuesta; el motor no lo elimina."
      ],
      "usageNotes": [
        "Usa el teclado para escribir è o é. El apóstrofo no sustituye al acento en estas palabras."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-citta",
        "it-caffe",
        "it-perche",
        "it-si",
        "it-e"
      ]
    },
    {
      "id": "it-a1-theory-c01-03",
      "version": "theory-c01-03-1",
      "conceptId": "it-a1-c01-03",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Le doppie: non è la stessa parola",
      "goal": "Reconocer y recuperar consonantes dobles en palabras enseñadas, sin deducir causas de un error aislado.",
      "introduction": "Una letra doble puede distinguir palabras italianas. Aprende la palabra completa y su significado: no añadas ni quites letras para que se parezca al español.",
      "rules": [
        "Pala (pala) y palla (pelota) son palabras distintas; también lo son penna (bolígrafo/pluma) y pena (pena).",
        "En caffè, letto, gatto y biglietto, la doble consonante forma parte de la grafía. No existe una regla única para deducir todas las dobles de este repertorio."
      ],
      "forms": [
        [
          "pala / palla",
          "pala / pelota"
        ],
        [
          "pena / penna",
          "pena / bolígrafo"
        ],
        [
          "caffè",
          "café"
        ],
        [
          "letto",
          "cama"
        ],
        [
          "gatto",
          "gato"
        ],
        [
          "biglietto",
          "billete"
        ]
      ],
      "examples": [
        [
          "Una penna.",
          "Un bolígrafo."
        ],
        [
          "Il letto.",
          "La cama."
        ],
        [
          "Un biglietto.",
          "Un billete."
        ]
      ],
      "frequentErrors": [
        "«Pala» es una palabra real, pero no significa pelota. Una respuesta incorrecta no basta para decidir si fue desconocimiento o una errata."
      ],
      "usageNotes": [
        "Puedes separar visualmente las letras al estudiar: p-e-n-n-a. En la respuesta escribe la palabra sin guiones. No estamos midiendo pronunciación."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-pala",
        "it-palla",
        "it-pena",
        "it-penna",
        "it-letto",
        "it-gatto",
        "it-caffe",
        "it-biglietto"
      ]
    }
  ],
