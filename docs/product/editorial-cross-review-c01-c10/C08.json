  "theories": [
    {
      "id": "it-a1-theory-c08-01",
      "version": "theory-c08-01-1-editorial-1",
      "conceptId": "it-a1-c08-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Una penna, due penne",
      "goal": "Formar y recuperar plurales regulares de nombres enseñados en -o, -a y -e.",
      "introduction": "El plural italiano suele cambiar la vocal final. No se forma añadiendo una s como en muchos nombres españoles.",
      "rules": [
        "Los nombres masculinos regulares en -o pasan a -i: biglietto → biglietti.",
        "Los femeninos regulares en -a pasan a -e: penna → penne. Los nombres regulares en -e de ambos géneros pasan a -i: chiave → chiavi; nome → nomi.",
        "La regla depende de la clase: problema es masculino y forma problemi; mano es femenino y forma mani. Estas excepciones se muestran como apoyo, no como una regla nueva universal."
      ],
      "forms": [
        [
          "biglietto → biglietti",
          "billete → billetes"
        ],
        [
          "penna → penne",
          "bolígrafo → bolígrafos"
        ],
        [
          "chiave → chiavi / nome → nomi",
          "llave → llaves / nombre → nombres"
        ]
      ],
      "examples": [
        [
          "Ho due biglietti.",
          "Tengo dos billetes."
        ],
        [
          "Abbiamo due chiavi.",
          "Tenemos dos llaves."
        ]
      ],
      "frequentErrors": [
        "«Bigliettos» no es el plural italiano.",
        "«Due chiave» conserva un singular donde se requiere chiavi."
      ],
      "usageNotes": [
        "Se trabajan nombres de cambio regular. Amico/amici y otras alternancias gráficas no se generan mediante estas reglas."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-biglietto",
        "it-penna",
        "it-chiave",
        "it-nome",
        "it-casa",
        "it-gatto",
        "it-due",
        "it-problema",
        "it-mano"
      ]
    },
    {
      "id": "it-a1-theory-c08-02",
      "version": "theory-c08-02-1-editorial-1",
      "conceptId": "it-a1-c08-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Due caffè, due città",
      "goal": "Interpretar y usar nombres invariantes frecuentes con número indicado por el contexto.",
      "introduction": "Algunos nombres mantienen la misma forma cuando hay uno o varios. El contexto, el número o el artículo permiten saber cuántos hay.",
      "rules": [
        "Los nombres con vocal final acentuada del repertorio no cambian: un caffè → due caffè; una città → due città.",
        "Los préstamos enseñados bar, hotel y film conservan su forma: due bar, due hotel, due film.",
        "La foto, abreviación de fotografia, también permanece foto en plural. Mantén los acentos: caffè y città."
      ],
      "forms": [
        [
          "caffè / città",
          "café-cafés / ciudad-ciudades"
        ],
        [
          "bar / hotel / film / foto",
          "bar-bares / hotel-hoteles / película-películas / foto-fotos"
        ]
      ],
      "examples": [
        [
          "Ho due foto.",
          "Tengo dos fotos."
        ],
        [
          "Due caffè, per favore.",
          "Dos cafés, por favor."
        ],
        [
          "Un hotel, due hotel.",
          "Un hotel, dos hoteles."
        ]
      ],
      "frequentErrors": [
        "No añadas -s: en este repertorio son due film, no films.",
        "«Caffei» y «cittài» no son estos plurales."
      ],
      "usageNotes": [
        "No se infiere que cualquier préstamo sea invariable. El alcance se limita a las palabras enseñadas; la forma aislada no siempre revela el número."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-caffe",
        "it-citta",
        "it-bar",
        "it-hotel",
        "it-film",
        "it-foto",
        "it-due",
        "it-per-favore"
      ]
    }
  ],
