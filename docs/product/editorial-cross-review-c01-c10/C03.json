  "theories": [
    {
      "id": "it-a1-theory-c03",
      "version": "theory-c03-01-2",
      "conceptId": "it-a1-c03-01",
      "conceptVersion": "2",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Io, tu, lui, lei, noi, voi, loro",
      "goal": "Identificar persona y número con los pronombres sujeto y con sujetos nominales.",
      "introduction": "El sujeto permite saber de quién se habla. Un nombre como Anna o un grupo como Anna e Luca también pueden ser sujeto. Las personas gramaticales dependen de quién habla y a quién se dirige.",
      "rules": [
        "Io es quien habla; tu, una persona con quien habla informalmente. Noi incluye a quien habla; voi se dirige a varias personas.",
        "Lui y lei remiten a una persona de la que se habla; loro, a varias. Anna se puede retomar con lei, Luca con lui y Anna e Luca con loro."
      ],
      "forms": [
        [
          "io / tu",
          "yo / tú"
        ],
        [
          "lui / lei",
          "él / ella"
        ],
        [
          "noi / voi",
          "nosotros o nosotras / vosotros, vosotras o ustedes"
        ],
        [
          "loro",
          "ellos / ellas"
        ],
        [
          "Anna / Anna e Luca",
          "una persona / varias personas"
        ]
      ],
      "examples": [
        [
          "Io sono Ana.",
          "Yo soy Ana."
        ],
        [
          "Voi siete Anna e Luca.",
          "Vosotros sois Anna y Luca."
        ],
        [
          "Anna e Luca sono qui. Loro sono qui.",
          "Anna y Luca están aquí. Ellos están aquí."
        ]
      ],
      "frequentErrors": [
        "Noi incluye a quien habla; voi no lo incluye. Loro sirve para grupos masculinos, femeninos o mixtos."
      ],
      "usageNotes": [
        "En el trato cortés, Lei se dirige a una sola persona con verbo de tercera persona; se profundizará en C18. Aquí se enseña como nota para reconocerlo, sin exigir todo su sistema.",
        "Las formas de essere de los ejemplos se estudian en C04. Estas actividades observan el referente, no todo el verbo."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-io",
        "it-tu",
        "it-lui",
        "it-lei",
        "it-noi",
        "it-voi",
        "it-loro",
        "it-qui"
      ]
    },
    {
      "id": "it-a1-theory-c03-02",
      "version": "theory-c03-02-1",
      "conceptId": "it-a1-c03-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Il soggetto può restare sottinteso",
      "goal": "Interpretar sujetos omitidos cuando el contexto basta y conservar o explicitar el referente cuando puede haber ambigüedad.",
      "introduction": "Como en español, en italiano a menudo no hace falta repetir el pronombre sujeto. El verbo y el contexto ayudan. Omitir no significa borrar información necesaria.",
      "rules": [
        "En una presentación propia, Sono Ana tiene el mismo referente que Io sono Ana. El pronombre explícito también puede ser correcto.",
        "Sono corresponde tanto a io como a loro: sin contexto no siempre sabemos quién es el sujeto. Repetir un nombre o un pronombre puede aclararlo.",
        "Cuando contrastas personas, io y tu pueden aportar énfasis útil. No hay una regla que prohíba los pronombres explícitos."
      ],
      "forms": [
        [
          "Io sono Ana. / Sono Ana.",
          "mismo referente en una presentación"
        ],
        [
          "Noi siamo qui. / Siamo qui.",
          "nosotros, por la forma verbal"
        ],
        [
          "Sono qui.",
          "yo o ellos/ellas, según contexto"
        ]
      ],
      "examples": [
        [
          "Mi chiamo Ana. Sono qui.",
          "Me llamo Ana. Estoy aquí."
        ],
        [
          "Anna e Luca? Sono qui.",
          "¿Anna y Luca? Están aquí."
        ],
        [
          "Io sono a Roma, tu sei a Madrid.",
          "Yo estoy en Roma, tú estás en Madrid."
        ]
      ],
      "frequentErrors": [
        "No identifiques automáticamente sono con yo. Tampoco consideres incorrecta cualquier frase con io explícito."
      ],
      "usageNotes": [
        "Mi chiamo se presenta como fórmula de apoyo, sin evaluar reflexivos. Cuando hay dos posibles referentes singulares, el contexto puede necesitar un nombre; no basta siempre con decir lei o lui."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-io",
        "it-tu",
        "it-noi",
        "it-loro",
        "it-qui",
        "it-essere"
      ]
    }
  ],
