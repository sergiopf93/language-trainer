  "theories": [
    {
      "id": "it-a1-theory-c02-01",
      "version": "theory-c02-01-1",
      "conceptId": "it-a1-c02-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Salutare e congedarsi",
      "goal": "Elegir y escribir saludos y despedidas adecuados a intercambios cotidianos formales e informales.",
      "introduction": "Aprende estas expresiones como unidades. La relación con la otra persona y el momento del intercambio ayudan a elegir: entrar, despedirse o desear buenas noches no son la misma acción.",
      "rules": [
        "Ciao sirve para saludar y despedirse en trato informal. Con una persona desconocida, buongiorno o buonasera suelen ser opciones más adecuadas al abrir el intercambio.",
        "Arrivederci es una despedida de uso amplio. Buonanotte se usa al despedirse para ir a dormir; no es el saludo normal al entrar en un hotel por la noche."
      ],
      "forms": [
        [
          "ciao",
          "hola / adiós informal"
        ],
        [
          "buongiorno",
          "buenos días"
        ],
        [
          "buonasera",
          "buenas tardes / noches al saludar"
        ],
        [
          "arrivederci",
          "adiós / hasta luego"
        ],
        [
          "buonanotte",
          "buenas noches al ir a dormir"
        ],
        [
          "a presto",
          "hasta pronto"
        ]
      ],
      "examples": [
        [
          "Buongiorno!",
          "¡Buenos días!"
        ],
        [
          "Ciao, Anna!",
          "¡Hola, Anna! / ¡Adiós, Anna!"
        ],
        [
          "Arrivederci, a presto!",
          "¡Hasta luego, hasta pronto!"
        ],
        [
          "Buonanotte!",
          "¡Buenas noches, que descanses!"
        ]
      ],
      "frequentErrors": [
        "No traduzcas todas las situaciones de «buenas noches» con buonanotte: al llegar, buonasera es una fórmula útil."
      ],
      "usageNotes": [
        "No fijamos una hora exacta universal para cambiar de buongiorno a buonasera; el uso varía. Las actividades dan un contexto claro."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-ciao",
        "it-buongiorno",
        "it-buonasera",
        "it-arrivederci",
        "it-buonanotte",
        "it-a-presto"
      ]
    },
    {
      "id": "it-a1-theory-c02-02",
      "version": "theory-c02-02-1",
      "conceptId": "it-a1-c02-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Grazie, prego, scusi",
      "goal": "Agradecer, responder a un agradecimiento y llamar la atención o disculparse con el registro adecuado.",
      "introduction": "Estas fórmulas ayudan a pedir atención y mantener un intercambio cortés. No necesitas conjugar sus verbos todavía: aprende qué hace cada expresión.",
      "rules": [
        "Grazie agradece; prego es una respuesta habitual a un agradecimiento. Per favore acompaña una petición.",
        "Scusa se usa con trato informal; scusi es una fórmula cortés al dirigirse a una persona de usted. Pueden introducir una petición de atención o una disculpa breve."
      ],
      "forms": [
        [
          "grazie",
          "gracias"
        ],
        [
          "prego",
          "de nada, al responder a gracias"
        ],
        [
          "per favore",
          "por favor"
        ],
        [
          "scusa",
          "disculpa, trato informal"
        ],
        [
          "scusi",
          "disculpe, trato cortés"
        ]
      ],
      "examples": [
        [
          "Grazie! — Prego!",
          "¡Gracias! — ¡De nada!"
        ],
        [
          "Un caffè, per favore.",
          "Un café, por favor."
        ],
        [
          "Scusi!",
          "¡Disculpe!"
        ]
      ],
      "frequentErrors": [
        "No intercambies grazie y prego: en el pequeño diálogo hacen funciones distintas. Scusi no es una forma plural de scusa."
      ],
      "usageNotes": [
        "Prego tiene otros usos; aquí se practica como respuesta a gracias. No se presentan todos sus significados como equivalentes."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-grazie",
        "it-prego",
        "it-per-favore",
        "it-scusa",
        "it-scusi",
        "it-caffe"
      ]
    },
    {
      "id": "it-a1-theory-c02-03",
      "version": "theory-c02-03-1",
      "conceptId": "it-a1-c02-03",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Non capisco. Può ripetere?",
      "goal": "Señalar incomprensión y pedir repetición o menor velocidad mediante fórmulas enseñadas.",
      "introduction": "Puedes pedir ayuda desde el primer día. Estas frases permiten continuar la conversación sin fingir que has entendido. Se aprenden como expresiones completas.",
      "rules": [
        "Non capisco comunica que no entiendes. Non lo so comunica que no lo sabes: son intenciones distintas.",
        "Può ripetere? pide repetición cortésmente. Puoi ripetere? corresponde al trato informal. Più lentamente, per favore pide menor velocidad."
      ],
      "forms": [
        [
          "non capisco",
          "no entiendo"
        ],
        [
          "può ripetere?",
          "¿puede repetir?"
        ],
        [
          "puoi ripetere?",
          "¿puedes repetir?"
        ],
        [
          "più lentamente, per favore",
          "más despacio, por favor"
        ],
        [
          "non lo so",
          "no lo sé; contraste de intención"
        ]
      ],
      "examples": [
        [
          "Scusi, non capisco.",
          "Disculpe, no entiendo."
        ],
        [
          "Può ripetere, per favore?",
          "¿Puede repetir, por favor?"
        ],
        [
          "Più lentamente, per favore.",
          "Más despacio, por favor."
        ]
      ],
      "frequentErrors": [
        "«Non lo so» no pide aclarar algo que no has entendido. En può hay acento; puoi no lo lleva."
      ],
      "usageNotes": [
        "No se evalúa aún el paradigma de capire o potere ni la formación general de preguntas. La práctica se centra en elegir y recuperar estas fórmulas."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-non-capisco",
        "it-puo-ripetere",
        "it-puoi-ripetere",
        "it-piu-lentamente",
        "it-non-lo-so",
        "it-per-favore",
        "it-scusi"
      ]
    }
  ],
