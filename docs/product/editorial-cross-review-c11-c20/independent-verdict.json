  "findings": [
    {
      "id": "XR-C20-02-CASA",
      "concept": "it-a1-c20-02",
      "entity": "it-a1-c20-02-casa",
      "class": "error confirmado",
      "evidence": "Riscrivi «Sono in casa» usando la locuzione a casa, senza cambiare il verbo. / accepted Sono a casa / dimension retrieval, facet a",
      "reason": "La operación solicitada proporciona íntegramente la locución objetivo a casa y obliga a conservar Sono. La respuesta se obtiene sustituyendo literalmente la locución; no queda recuperación de la preposición que constituye el objetivo de este concepto. La distinción lingüística in casa/a casa del feedback es correcta.",
      "proposal": "Conservar la explicación que admite in casa, pero pedir traducir «Estoy en casa» con essere, sin indicar la preposición; o reclasificar explícitamente como transformación guiada sin evidencia de recuperación de a. No ampliar accepted como sustituto de acotar la tarea.",
      "certainty": "alta"
    },
    {
      "id": "XR-C20-02-HOTEL",
      "concept": "it-a1-c20-02",
      "entity": "it-a1-c20-02-hotel",
      "class": "error confirmado",
      "evidence": "Traduci con in hotel: «Trabajo en un hotel». / facet in / accepted Lavoro in hotel, Io lavoro in hotel",
      "reason": "La locución con la preposición objetivo se entrega completa. Se recupera lavorare, pero no in, que es la faceta evaluada en este concepto. Como apoyo al verbo sería legítima; como evidencia de la preposición no lo es.",
      "proposal": "Pedir la traducción usando lavorare y hotel, sin suministrar in hotel, o usar reconocimiento explícitamente guiado sin atribuir recuperación independiente de in.",
      "certainty": "alta"
    },
    {
      "id": "XR-C15-01-CLASSI",
      "concept": "it-a1-c15-01",
      "entity": "it-a1-c15-01-classi",
      "class": "mejora opcional",
      "evidence": "Scegli la coppia corretta per loro: parlare / leggere. Opciones parlano / leggono y parlano / leggano.",
      "reason": "El marco de la Theory hace interpretable que se busca indicativo, pero leggano existe en subjuntivo y la explicación -ere usa -ono carece de restricción explícita de modo. No constituye un rechazo universal demostrado, dado el contexto del concepto.",
      "proposal": "Añadir al presente indicativo a consigna y explicación para mantener la precisión que ya aparece en otras actividades del mismo concepto.",
      "certainty": "alta"
    },
    {
      "id": "XR-C17-03-DEBBO",
      "concept": "it-a1-c17-03",
      "entity": "it-a1-c17-03-forma-io",
      "class": "mejora opcional",
      "evidence": "accepted devo y debbo; hint y explanation: Con io, el presente de dovere es devo.",
      "reason": "La respuesta debbo está correctamente admitida y la Theory la explica. El feedback no menciona la variante que el alumno puede haber elegido; no es un error de evaluación.",
      "proposal": "Indicar devo, también debbo en el feedback de esta actividad.",
      "certainty": "alta"
    },
    {
      "id": "XR-HINT-DISPLAY",
      "concept": "it-a1-c11-01",
      "entity": "it-a1-c11-01-case",
      "class": "requiere validación humana",
      "evidence": "prompt Le case sono ___ (piccolo); hint Case es femenino plural: piccole; scaffolding none. El mismo patrón de pistas resolutivas aparece en muchas actividades.",
      "reason": "La pista entrega la solución, lo cual puede ser legítimo si se solicita tras un intento y la evidencia se marca como asistida. El paquete no define cuándo se muestra ni cómo afecta a la evidencia; no se afirma que exista una fuga visible en la interfaz.",
      "proposal": "Verificar en validación de producto que las pistas resolutivas no se muestran inicialmente como parte de la consigna de recuperación y que pedirlas se registra como ayuda. No implica reescribir todas las pistas.",
      "certainty": "alta sobre el contenido; no determinado sobre la interfaz"
    }
  ],
