  "theories": [
    {
      "id": "it-a1-theory-c14-01",
      "version": "theory-c14-01-1",
      "conceptId": "it-a1-c14-01",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Il presente regolare in -are",
      "goal": "Recuperar el presente regular -are de parlare, lavorare, abitare y studiare relacionando infinitivo, raíz, terminaciones y persona.",
      "introduction": "Aprende el significado junto con las seis personas. El pronombre ayuda a estudiar el paradigma, pero se puede omitir cuando la forma y el contexto identifican al sujeto.",
      "rules": [
        "En un verbo regular -are separa la terminación del infinitivo: parl-are. Añade -o, -i, -a, -iamo, -ate, -ano según la persona.",
        "El mismo patrón sirve para lavorare (trabajar) y abitare (vivir/residir): lavoro/lavori/lavora/lavoriamo/lavorate/lavorano; abito/abiti/abita/abitiamo/abitate/abitano.",
        "Studiare conserva la i de su base salvo que la terminación ya la aporte: studio, studi, studia, studiamo, studiate, studiano. No escribas studii o studiiamo en el presente de estas personas.",
        "La negación sigue delante del verbo: non parlo. Una pregunta mantiene la forma de la persona: Parli italiano?"
      ],
      "forms": [
        [
          "io parlo",
          "hablo"
        ],
        [
          "tu parli",
          "hablas"
        ],
        [
          "lui/lei parla",
          "habla"
        ],
        [
          "noi parliamo",
          "hablamos"
        ],
        [
          "voi parlate",
          "habláis / hablan"
        ],
        [
          "loro parlano",
          "hablan"
        ]
      ],
      "examples": [
        [
          "Parlo italiano.",
          "Hablo italiano."
        ],
        [
          "Lavoriamo in hotel.",
          "Trabajamos en un hotel."
        ]
      ],
      "frequentErrors": [
        "No uses el infinitivo con un sujeto como «io parlare».",
        "La primera persona plural termina en -iamo, no -amos."
      ],
      "usageNotes": [
        "Las preposiciones y complementos dados son apoyo; el objetivo es el verbo de esta ficha."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-parlare",
        "it-lavorare",
        "it-abitare",
        "it-studiare",
        "it-italiano",
        "it-spagnolo",
        "it-roma",
        "it-hotel",
        "it-con",
        "it-non"
      ],
      "status": "candidate",
      "provenance": "Candidate de R2: Research 02 C11–C17 y A1_COVERAGE_MATRIX. Ejemplos originales; revisión editorial independiente pendiente. Research 02 C14; A1_COVERAGE_MATRIX C14. https://www.treccani.it/enciclopedia/verbi_(Enciclopedia-dell%27Italiano)/"
    },
    {
      "id": "it-a1-theory-c14-02",
      "version": "theory-c14-02-1",
      "conceptId": "it-a1-c14-02",
      "conceptVersion": "1",
      "targetLanguage": "it",
      "supportLanguage": "es",
      "title": "Studio, lavoro, abito",
      "goal": "Elegir y usar verbos -are enseñados para estudio, trabajo, residencia y actividad habitual.",
      "introduction": "La forma correcta también necesita el verbo adecuado: studiare para estudiar, lavorare para trabajar, abitare para residir y parlare para hablar. El presente comunica actividades habituales y situaciones actuales.",
      "rules": [
        "Abito a Roma expresa residencia; lavoro a Roma expresa lugar de trabajo. No significan lo mismo.",
        "Studio italiano indica aprendizaje; parlo italiano indica uso de la lengua. El contexto de la actividad decide el verbo.",
        "Habitualmente se puede usar ogni giorno (cada día): lavoro ogni giorno. No hace falta un tiempo verbal distinto.",
        "La negación va delante del verbo elegido; non lavoro no significa non studio. Mantén la persona aunque cambie la intención."
      ],
      "forms": [
        [
          "abitare",
          "residir"
        ],
        [
          "lavorare",
          "trabajar"
        ],
        [
          "studiare",
          "estudiar"
        ],
        [
          "parlare",
          "hablar"
        ],
        [
          "ogni giorno",
          "cada día"
        ]
      ],
      "examples": [
        [
          "Studio italiano ogni giorno.",
          "Estudio italiano cada día."
        ],
        [
          "Abitiamo a Roma.",
          "Vivimos en Roma."
        ]
      ],
      "frequentErrors": [
        "No elijas lavorare para expresar dónde resides.",
        "Estudiar y hablar una lengua no son acciones idénticas."
      ],
      "usageNotes": [
        "A Roma e in hotel son combinaciones de apoyo ya conocidas; no se evalúa todo el sistema preposicional."
      ],
      "exceptions": [],
      "contrasts": [],
      "vocabularyIds": [
        "it-studiare",
